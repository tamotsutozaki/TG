{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(powershell.exe:*)",
      "Bash(pwsh:*)",
      "Bash(pwsh.exe:*)",
      "Bash(dism:*)",
      "Bash(DISM:*)",
      "Bash(systeminfo:*)",
      "Bash(bcdedit:*)",
      "Bash(Get-*:*)",
      "Bash(emulator:*)",
      "Bash(adb:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(git:*)",
      "Read(**)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/session.md ]; then printf '%s\\n' '--- Contexto da sessão anterior (.claude/session.md) ---'; cat .claude/session.md; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Users\\Pedro\\.claude\\plugins\\cache\\caveman\\caveman\\84cc3c14fa1e\\hooks\\caveman-statusline.ps1\""
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "pt",
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
